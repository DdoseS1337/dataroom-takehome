# Pooled connection (pgBouncer, transaction mode) — used by the running app.
DATABASE_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres"
# Direct session-mode connection — used by the Prisma CLI for migrations, which take
# an advisory lock that a transaction-mode pooler cannot hold.
DIRECT_URL="postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres"

SUPABASE_URL="https://PROJECT_REF.supabase.co"
# Server only. Never sent to the browser — it bypasses RLS.
SUPABASE_SERVICE_ROLE_KEY=""
STORAGE_BUCKET="dataroom-files"

# Fill exactly one, matching the project's JWT key type
# (Dashboard -> Project Settings -> API Keys -> JWT Keys):
#   asymmetric (ES256/RS256, current default) -> SUPABASE_JWKS_URL
#   legacy shared secret (HS256)              -> SUPABASE_JWT_SECRET
# Both are blank on purpose. A pre-filled JWKS URL wins over a secret you did fill in,
# and because the key set is fetched lazily the mistake surfaces as a generic 401 on
# every request rather than as an error at boot.
SUPABASE_JWKS_URL=""
SUPABASE_JWT_SECRET=""

# Comma-separated. Add the Vercel production and preview origins in deployment.
# The seed prints its share link against the first entry.
FRONTEND_ORIGIN="http://localhost:3000"
PORT=3001

# The account `pnpm --filter api seed` creates and fills. It is also what the "Try demo
# account" button on /login signs in as, so the same pair belongs in apps/web/.env.local.
# No default: the seed deletes every room owned by this address, so an unset value must
# stop it rather than widen what it can reach.
DEMO_EMAIL="demo@example.com"
DEMO_PASSWORD=""
