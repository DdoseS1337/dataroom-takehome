# The browser holds the anon key and uses it only to sign in. All data and every
# authorisation decision come from the API.
NEXT_PUBLIC_SUPABASE_URL="https://PROJECT_REF.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY=""

NEXT_PUBLIC_API_URL="http://localhost:3001"

# The credentials behind the "Try demo account" button, which is only rendered when both
# are set. They reach the browser, which is the point — the same pair is printed in
# README.md. Must match DEMO_EMAIL and DEMO_PASSWORD in apps/api/.env, which is what the
# seed signs in as.
NEXT_PUBLIC_DEMO_EMAIL="demo@example.com"
NEXT_PUBLIC_DEMO_PASSWORD=""
